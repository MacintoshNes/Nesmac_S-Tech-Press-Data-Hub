<style>
:root{
  --navy:#071b49; --navy2:#0d2b67; --gold:#ffc400; --yellow:#ffe600;
  --red:#e71922; --blue:#0b4fa8; --ink:#101828; --muted:#667085;
  --bg:#f5f8fc; --white:#fff; --shadow:0 16px 45px rgba(7,27,73,.12);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}
a{text-decoration:none;color:inherit}
.container{width:min(1180px,92%);margin:auto}
.topbar{background:var(--navy);color:#fff;text-align:center;padding:9px 16px;font-size:.9rem}
header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);backdrop-filter:blur(12px);border-bottom:1px solid #e6ebf2}
.nav{height:78px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:12px;font-weight:900;color:var(--navy)}
.logo{width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,var(--navy),var(--blue));color:#fff;display:grid;place-items:center;font-weight:900}
.brand small{display:block;color:var(--muted);font-size:.72rem;margin-top:2px}
nav{display:flex;gap:24px;align-items:center;font-weight:700;font-size:.94rem}
nav a:hover{color:var(--blue)}
.cta{background:var(--gold);padding:12px 18px;border-radius:999px;color:#111;font-weight:900}
.hero{padding:76px 0 60px;background:
 radial-gradient(circle at 10% 15%,rgba(255,196,0,.24),transparent 28%),
 radial-gradient(circle at 90% 10%,rgba(11,79,168,.16),transparent 28%),
 linear-gradient(180deg,#fff 0%,#f4f8ff 100%)}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:45px;align-items:center}
.badge{display:inline-flex;align-items:center;gap:8px;background:#fff4bf;border:1px solid #ffe27a;padding:8px 13px;border-radius:999px;font-weight:800;font-size:.85rem}
h1{font-size:clamp(2.5rem,6vw,5.3rem);line-height:.95;margin:18px 0;color:var(--navy);letter-spacing:-.055em}
h1 span{color:#e2a900}
.hero p{font-size:1.12rem;line-height:1.75;color:#475467;max-width:680px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}
.btn{padding:14px 20px;border-radius:12px;font-weight:900;border:1px solid #d7deea}
.btn-primary{background:var(--navy);color:#fff;border-color:var(--navy)}
.btn-gold{background:var(--gold);border-color:var(--gold)}
.hero-card{background:var(--navy);border-radius:28px;padding:28px;color:#fff;box-shadow:var(--shadow);position:relative;overflow:hidden}
.hero-card:before{content:"";position:absolute;width:240px;height:240px;border-radius:50%;background:rgba(255,196,0,.16);right:-80px;top:-80px}
.hero-card h3{font-size:1.55rem;margin:0 0 18px;position:relative}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:12px;position:relative}
.stat{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.12);padding:18px;border-radius:18px}
.stat strong{font-size:1.45rem;display:block;color:var(--gold)}
.stat span{font-size:.82rem;color:#d9e3f4}
section{padding:76px 0}
.section-head{text-align:center;max-width:720px;margin:0 auto 35px}
.section-head h2{font-size:clamp(2rem,4vw,3rem);margin:0 0 10px;color:var(--navy)}
.section-head p{color:var(--muted);line-height:1.7}
.network-tabs{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-bottom:28px}
.tab{border:0;background:#e9eef7;color:var(--navy);padding:11px 17px;border-radius:999px;font-weight:900;cursor:pointer}
.tab.active{background:var(--navy);color:#fff}
.network-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.network-card{background:#fff;border-radius:24px;overflow:hidden;box-shadow:var(--shadow);border:1px solid #e7ebf2}
.network-head{padding:22px;color:#fff}
.network-head h3{margin:0;font-size:1.35rem}
.network-head p{margin:5px 0 0;opacity:.9;font-size:.86rem}
.mtn{background:linear-gradient(135deg,#ffd900,#f2ad00);color:#101010}
.airtel{background:linear-gradient(135deg,#124f9e,#071f57)}
.telecel{background:linear-gradient(135deg,#ed1b24,#a40009)}
.bundle-list{padding:10px;max-height:590px;overflow:auto}
.bundle{display:flex;justify-content:space-between;gap:8px;padding:10px 9px;border-bottom:1px solid #edf0f5;font-size:.86rem}
.bundle:last-child{border-bottom:0}
.bundle b{color:var(--navy)}
.price{font-weight:900;white-space:nowrap}
.promo{margin:12px;background:#fff6cf;border:1px dashed #e5b600;padding:13px;border-radius:14px;text-align:center;font-weight:900}
.delivery{margin:0 12px 14px;padding:13px;border-radius:13px;background:#f4f7fb;text-align:center;font-weight:900;color:var(--navy)}
.features{background:var(--navy);color:#fff}
.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.feature{padding:25px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:20px}
.feature .icon{font-size:1.8rem}.feature h3{margin:12px 0 7px}.feature p{color:#cbd7ec;line-height:1.55;font-size:.9rem}
.contact{background:#fff}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:stretch}
.contact-card{padding:32px;border-radius:24px;background:#f5f8fc;border:1px solid #e4e9f1}
.contact-card h3{font-size:1.6rem;color:var(--navy);margin-top:0}
.contact-row{display:flex;gap:12px;align-items:center;padding:13px 0;border-bottom:1px solid #e4e9f1}
.contact-row:last-child{border:0}
.wa{background:#1aae5b;color:#fff;padding:14px 18px;border-radius:12px;display:inline-block;font-weight:900;margin-top:12px}
footer{background:#050f29;color:#cbd7ec;padding:25px 0}
.footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
footer strong{color:#fff}
#toast{position:fixed;right:20px;bottom:20px;background:#101828;color:#fff;padding:13px 17px;border-radius:12px;box-shadow:var(--shadow);display:none;z-index:100}
@media(max-width:950px){
 .hero-grid{grid-template-columns:1fr}.network-grid{grid-template-columns:repeat(2,1fr)}.feature-grid{grid-template-columns:repeat(2,1fr)}
